@model RegisterUserViewModel?
@{
    ViewData["Title"] = "Únete a la app";
}

<div class="auth-wrap auth-wrap-tight">
    <div class="auth-card auth-card-wide">
        <div class="text-center auth-brand">
            <svg class="icon"><use href="#i-building" /></svg>
        </div>
        <h1 class="text-center mb-1">Únete a la app</h1>
        <p class="text-center text-secondary mb-4">Crea tu cuenta como cliente o agente inmobiliario</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-app validation-summary-errors"></div>

        <form method="post" asp-controller="Join" asp-action="Index" enctype="multipart/form-data">
            <fieldset class="form-section form-section-tight">
                <legend>Datos personales</legend>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LastName" class="form-label">Apellido</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Phone" class="form-label">Teléfono</label>
                        <input asp-for="Phone" class="form-control" placeholder="809-555-0000" />
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Photo" class="form-label">Foto de usuario</label>
                        <div class="photo-field">
                            <span class="photo-preview-empty" data-photo-placeholder>
                                <svg class="icon"><use href="#i-user" /></svg>
                            </span>
                            <img class="photo-preview d-none" alt="Vista previa de la foto" data-photo-preview />
                            <div class="photo-control">
                                <input asp-for="Photo" type="file" class="photo-input" accept=".jpg,.jpeg,.png" data-photo-input />
                                <label asp-for="Photo" class="photo-btn">Subir foto</label>
                                <span class="photo-name" data-photo-name>JPG o PNG</span>
                            </div>
                        </div>
                        <span asp-validation-for="Photo" class="field-validation-error"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section form-section-tight">
                <legend>Datos de la cuenta</legend>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section form-section-tight">
                <legend>Tipo de usuario</legend>
                <div class="role-choice">
                    <div>
                        <input asp-for="UserType" type="radio" value="@Roles.Client" id="userTypeClient" />
                        <label class="role-option" for="userTypeClient">
                            <span class="role-option-title">
                                <svg class="icon"><use href="#i-user" /></svg>
                                Cliente
                            </span>
                            <span class="role-option-note">Busca propiedades, guarda favoritas y envía ofertas. Recibirás un correo para confirmar tu cuenta antes de iniciar sesión.</span>
                        </label>
                    </div>
                    <div>
                        <input asp-for="UserType" type="radio" value="@Roles.Agent" id="userTypeAgent" />
                        <label class="role-option" for="userTypeAgent">
                            <span class="role-option-title">
                                <svg class="icon"><use href="#i-building" /></svg>
                                Agente
                            </span>
                            <span class="role-option-note">Publica propiedades y negocia con clientes. Un administrador debe activar tu cuenta antes de que puedas iniciar sesión.</span>
                        </label>
                    </div>
                </div>
                <span asp-validation-for="UserType" class="field-validation-error"></span>
            </fieldset>

            <button type="submit" class="btn btn-brand w-100 py-2">Registrarse</button>
        </form>

        <p class="text-center text-secondary mt-3 mb-0">
            ¿Ya tienes cuenta? <a class="text-decoration-none" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
            <span class="auth-sep">·</span>
            <a class="text-decoration-none" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
