@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <div class="empty-state">
        <svg class="icon"><use href="#i-building" /></svg>
        <h1 class="h4">Ocurrió un error procesando su solicitud</h1>
        @if (Model.ShowRequestId)
        {
            <p class="text-secondary"><small>Identificador de la solicitud: <code>@Model.RequestId</code></small></p>
        }
        <a class="btn btn-outline-brand mt-3" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
