@using RealEstateApp.Core.Application.Dtos.Common
@model List<CatalogItemDto>
@{
    var title = ViewData["Title"] as string;
    var lead = ViewData["Lead"] as string;
    var createText = ViewData["CreateText"] as string;
}

<div class="container">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1>@title</h1>
            <p class="lead-soft">@lead</p>
        </div>
        <a class="btn btn-brand" asp-action="Create">@createText</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-tag" /></svg>
            <p>@ViewBag.EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="panel p-0">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Descripción</th>
                        <th>Propiedades asociadas</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@item.Name</td>
                            <td class="text-secondary">@item.Description</td>
                            <td>@item.PropertiesQuantity</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-brand" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                                    <a class="btn btn-sm btn-ghost" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
