@model List<PropertyDto>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <svg class="icon"><use href="#i-building" /></svg>
        <p>@(ViewData["EmptyMessage"] ?? "No se encontraron propiedades disponibles con los filtros seleccionados.")</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var property in Model)
        {
            <div class="col">
                <partial name="_PropertyCard" model="property" view-data="ViewData" />
            </div>
        }
    </div>
}
