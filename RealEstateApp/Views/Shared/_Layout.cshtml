<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
        <symbol id="i-home" viewBox="0 0 16 16">
            <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z" />
        </symbol>
        <symbol id="i-building" viewBox="0 0 16 16">
            <path d="M4 2.5A1.5 1.5 0 0 1 5.5 1h5A1.5 1.5 0 0 1 12 2.5V14h1.5a.5.5 0 0 1 0 1h-11a.5.5 0 0 1 0-1H4zm2 .5v1h1V3zm3 0v1h1V3zM6 6v1h1V6zm3 0v1h1V6zM6 9v1h1V9zm3 0v1h1V9zm-2 5V12h2v2z" />
        </symbol>
        <symbol id="i-bed" viewBox="0 0 16 16">
            <path d="M1 3.5a.5.5 0 0 1 1 0V9h5V6.5a.5.5 0 0 1 .5-.5h5A2.5 2.5 0 0 1 15 8.5v4a.5.5 0 0 1-1 0V11H2v1.5a.5.5 0 0 1-1 0zM4.5 8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3" />
        </symbol>
        <symbol id="i-bath" viewBox="0 0 16 16">
            <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h1A1.5 1.5 0 0 1 6 2.5v.55a2.5 2.5 0 0 1 2 2.45v.5H2zM1 7.5a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1H14v2a3 3 0 0 1-2 2.83V14a.5.5 0 0 1-1 0v-1H5v1a.5.5 0 0 1-1 0v-1.17A3 3 0 0 1 2 10V8h-.5a.5.5 0 0 1-.5-.5" />
        </symbol>
        <symbol id="i-ruler" viewBox="0 0 16 16">
            <path d="M1 3.5A1.5 1.5 0 0 1 2.5 2h11A1.5 1.5 0 0 1 15 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5zM2.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5H12v3a.5.5 0 0 1-1 0V3H9v2a.5.5 0 0 1-1 0V3H6v3a.5.5 0 0 1-1 0V3z" />
        </symbol>
        <symbol id="i-search" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
        </symbol>
        <symbol id="i-user" viewBox="0 0 16 16">
            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
        </symbol>
        <symbol id="i-mail" viewBox="0 0 16 16">
            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z" />
        </symbol>
        <symbol id="i-phone" viewBox="0 0 16 16">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z" />
        </symbol>
        <symbol id="i-heart" viewBox="0 0 16 16">
            <path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01z" />
        </symbol>
        <symbol id="i-tag" viewBox="0 0 16 16">
            <path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.586-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1zm4 3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0" />
        </symbol>
        <symbol id="i-check" viewBox="0 0 16 16">
            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z" />
        </symbol>
    </svg>

    <header>
        <nav class="navbar navbar-expand-md navbar-app sticky-top">
            <div class="container">
                <a class="navbar-brand d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <svg class="icon"><use href="#i-building" /></svg>
                    RealEstateApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="Index">Home</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Agent" asp-action="Index">Agentes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Client" asp-action="Favorites">Mis propiedades</a></li>
                            }
                            @if (User.IsInRole("Agent"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="AgentHome" asp-action="Index">Home del agente</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="PropertyMaintenance" asp-action="Index">Mantenimiento de propiedades</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Mi perfil</a></li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Home</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mantenimientos</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="AgentsAdmin" asp-action="Index">Listado de los agentes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Administrators" asp-action="Index">Administradores</a></li>
                                        <li><a class="dropdown-item" asp-controller="Developers" asp-action="Index">Desarrolladores</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="PropertyTypes" asp-action="Index">Tipos de propiedades</a></li>
                                        <li><a class="dropdown-item" asp-controller="SaleTypes" asp-action="Index">Tipos de ventas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Improvements" asp-action="Index">Mejoras</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Agent" asp-action="Index">Agentes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Join" asp-action="Index">Únete a la app</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="user-chip">
                                <svg class="icon"><use href="#i-user" /></svg>
                                @User.Identity.Name
                            </span>
                            <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-ghost">Cerrar sesión</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-brand" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Toast"] != null || TempData["ToastError"] != null)
    {
        <div class="toast-stack">
            @if (TempData["Toast"] != null)
            {
                <div class="app-toast">@TempData["Toast"]</div>
            }
            @if (TempData["ToastError"] != null)
            {
                <div class="app-toast is-error">@TempData["ToastError"]</div>
            }
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-app">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; 2026 RealEstateApp</span>
            <span>Gestión inmobiliaria en República Dominicana</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
