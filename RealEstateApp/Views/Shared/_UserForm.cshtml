@model SaveUserViewModel
@{
    var isEdit = !string.IsNullOrWhiteSpace(Model.Id);
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger alert-app validation-summary-errors"></div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Nombre</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Apellido</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="IdentityCard" class="form-label">Cédula</label>
            <input asp-for="IdentityCard" class="form-control" />
            <span asp-validation-for="IdentityCard" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UserName" class="form-label">Nombre de usuario</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="field-validation-error"></span>
        </div>
        <div class="col-12"><hr class="my-1" /></div>
        <div class="col-md-6">
            <label asp-for="Password" class="form-label">@(isEdit ? "Nueva contraseña (opcional)" : "Contraseña")</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-brand">@(isEdit ? "Guardar cambios" : "Crear")</button>
        <a class="btn btn-ghost" asp-action="Index">Volver atrás</a>
    </div>
</form>
