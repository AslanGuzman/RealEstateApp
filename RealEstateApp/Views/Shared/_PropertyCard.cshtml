@model PropertyDto
@{
    var detailController = ViewData["DetailController"] as string ?? "Home";
    var culture = new CultureInfo("es-DO");
}

<a class="text-decoration-none" asp-controller="@detailController" asp-action="Detail" asp-route-id="@Model.Id">
    <article class="property-card">
        <div class="cover">
            @if (Model.Images.Count > 0)
            {
                <img src="~/@Model.Images.First()" alt="Imagen de la propiedad @Model.Code" />
            }
            else
            {
                <div class="cover-empty">
                    <svg class="icon"><use href="#i-building" /></svg>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SaleTypeName))
            {
                <span class="badge-sale">@Model.SaleTypeName</span>
            }
            @if (Model.Status == PropertyStatus.Sold)
            {
                <span class="badge-sold">Vendida</span>
            }
        </div>
        <div class="body">
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge-type">@Model.PropertyTypeName</span>
                <span class="code">Código @Model.Code</span>
            </div>
            <p class="price">@Model.Price.ToString("C0", culture)</p>
            <div class="property-meta">
                <span><svg class="icon"><use href="#i-bed" /></svg> @Model.Rooms hab.</span>
                <span><svg class="icon"><use href="#i-bath" /></svg> @Model.Bathrooms baños</span>
                <span><svg class="icon"><use href="#i-ruler" /></svg> @Model.LandSize.ToString("N0", culture) m²</span>
            </div>
        </div>
    </article>
</a>
