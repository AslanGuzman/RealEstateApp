@model List<AgentDto>
@{
    ViewData["Title"] = "Agentes";
    ViewData["SearchController"] = "Agent";
    ViewData["SearchField"] = "name";
    ViewData["SearchPlaceholder"] = "Buscar por nombre o apellido";
    var searchName = ViewBag.SearchName as string;
}

<section class="search-hero">
    <div class="container">
        <h1>Nuestros agentes</h1>
        <p class="lead-soft">Profesionales inmobiliarios listos para ayudarte</p>
        <partial name="_SearchBar" view-data="ViewData" />
        @if (!string.IsNullOrWhiteSpace(searchName))
        {
            <div class="filter-chips mt-3">
                <span class="filter-chips-label">Búsqueda activa</span>
                <span class="filter-chip">
                    @searchName
                    <a class="chip-remove" asp-controller="Agent" asp-action="Index" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">&times;</a>
                </span>
            </div>
        }
    </div>
</section>

<div class="container py-4">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-user" /></svg>
            <p>@ViewBag.EmptyMessage</p>
        </div>
    }
    else
    {
        <p class="results-count">@Model.Count @(Model.Count == 1 ? "agente activo" : "agentes activos")</p>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var agent in Model)
            {
                <div class="col">
                    <a class="text-decoration-none" asp-controller="Agent" asp-action="Properties" asp-route-id="@agent.Id">
                        <div class="agent-card">
                            @if (!string.IsNullOrWhiteSpace(agent.ProfileImage))
                            {
                                <img class="avatar mb-3" src="~/@agent.ProfileImage" alt="Foto de @agent.Name" />
                            }
                            else
                            {
                                <span class="avatar-empty mb-3">
                                    <svg class="icon"><use href="#i-user" /></svg>
                                </span>
                            }
                            <h2 class="h5 mb-1">@agent.Name @agent.LastName</h2>
                            <p class="text-secondary mb-0">@agent.PropertiesQuantity propiedades</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
