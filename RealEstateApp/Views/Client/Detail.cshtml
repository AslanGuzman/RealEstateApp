@using RealEstateApp.Core.Application.Dtos.Chat
@using RealEstateApp.Core.Application.Dtos.Offer
@model PropertyDto?
@{
    ViewData["Title"] = Model == null ? "Propiedad no disponible" : $"Propiedad {Model.Code}";
    var culture = new CultureInfo("es-DO");
    var agent = ViewBag.AgentContact as AgentContactDto;
    var conversation = ViewBag.Conversation as List<ChatMessageDto> ?? [];
    var offers = ViewBag.Offers as List<OfferDto> ?? [];
    var hasPending = ViewBag.HasPending as bool? ?? false;
    var hasAccepted = ViewBag.HasAccepted as bool? ?? false;
    var isSold = Model != null && Model.Status == PropertyStatus.Sold;
    var canOffer = Model != null && !isSold && !hasAccepted && !hasPending;
    var blockedReason = isSold
        ? "Esta propiedad ya no se encuentra disponible para recibir ofertas."
        : hasAccepted
            ? "Esta propiedad ya tiene una oferta aceptada y no permite nuevas ofertas."
            : hasPending
                ? "Ya tiene una oferta pendiente para esta propiedad."
                : null;
}

<div class="container py-4">
    @if (Model == null)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-building" /></svg>
            <p>@ViewBag.EmptyMessage</p>
            <a class="btn btn-outline-brand mt-3" asp-controller="Client" asp-action="Index">Volver al inicio</a>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb" class="pt-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-decoration-none" asp-controller="Client" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Propiedad @Model.Code</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-8">
                <partial name="_PropertyGallery" model="Model" />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                    <div>
                        <span class="badge-type">@Model.PropertyTypeName</span>
                        <span class="badge-type">@Model.SaleTypeName</span>
                        @if (isSold)
                        {
                            <span class="badge-sold position-static d-inline-block">Vendida</span>
                        }
                    </div>
                    <span class="code text-secondary">Código @Model.Code</span>
                </div>

                <h1 class="mt-2 money">@Model.Price.ToString("C0", culture)</h1>

                <div class="detail-facts mt-3">
                    <div class="fact"><span class="fact-label">Habitaciones</span><span class="fact-value"><svg class="icon"><use href="#i-bed" /></svg> @Model.Rooms</span></div>
                    <div class="fact"><span class="fact-label">Baños</span><span class="fact-value"><svg class="icon"><use href="#i-bath" /></svg> @Model.Bathrooms</span></div>
                    <div class="fact"><span class="fact-label">Tamaño</span><span class="fact-value"><svg class="icon"><use href="#i-ruler" /></svg> @Model.LandSize.ToString("N0", culture) m²</span></div>
                </div>

                <h2 class="section-title mt-4">Descripción</h2>
                <p class="text-secondary">@Model.Description</p>

                <h2 class="section-title mt-4">Mejoras</h2>
                @if (Model.Improvements.Count == 0)
                {
                    <p class="text-secondary">Esta propiedad no tiene mejoras registradas.</p>
                }
                else
                {
                    <div>
                        @foreach (var improvement in Model.Improvements)
                        {
                            <span class="improvement-chip"><svg class="icon"><use href="#i-check" /></svg> @improvement.Name</span>
                        }
                    </div>
                }

                <h2 class="section-title mt-5">Conversación con el agente</h2>
                <div class="panel p-3 mb-3 chat-box" data-chat-scroll>
                    @if (conversation.Count == 0)
                    {
                        <p class="chat-empty mb-0 py-3">Aún no ha iniciado una conversación con el agente.</p>
                    }
                    else
                    {
                        @foreach (var message in conversation)
                        {
                            <div class="chat-msg @(message.SenderRole == Roles.Client ? "mine" : "theirs")">
                                <div class="chat-bubble">
                                    <p class="mb-1">@message.Content</p>
                                    <span class="chat-time">@message.SentAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (!isSold)
                {
                    <form method="post" asp-controller="Client" asp-action="SendMessage">
                        <input type="hidden" name="PropertyId" value="@Model.Id" />
                        <div class="input-group">
                            <input class="form-control" name="Content" placeholder="Escriba un mensaje para el agente" />
                            <button class="btn btn-brand" type="submit">Enviar mensaje</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-secondary">Esta propiedad ya fue vendida y no permite nuevos mensajes.</p>
                }
            </div>

            <div class="col-lg-4">
                <div class="panel p-4 text-center mb-4">
                    <h2 class="section-title">Agente inmobiliario</h2>
                    @if (agent == null)
                    {
                        <p class="text-secondary mb-0">La información del agente no está disponible.</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(agent.ProfileImage))
                        {
                            <img class="avatar mb-3" src="~/@agent.ProfileImage" alt="Foto de @agent.Name" />
                        }
                        else
                        {
                            <span class="avatar-empty mb-3"><svg class="icon"><use href="#i-user" /></svg></span>
                        }
                        <h3 class="h5 mb-3">@agent.Name @agent.LastName</h3>
                        <p class="mb-2 text-secondary"><svg class="icon"><use href="#i-phone" /></svg> @(string.IsNullOrWhiteSpace(agent.Phone) ? "Sin teléfono registrado" : agent.Phone)</p>
                        <p class="mb-0 text-secondary"><svg class="icon"><use href="#i-mail" /></svg> @agent.Email</p>
                    }
                </div>

                <div class="panel p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="section-title mb-0">Mis ofertas</h2>
                        <button type="button" class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#offerModal" @(canOffer ? "" : "disabled")>
                            Enviar nueva oferta
                        </button>
                    </div>

                    @if (blockedReason != null)
                    {
                        <div class="offer-blocked">
                            <svg class="icon"><use href="#i-tag" /></svg>
                            <span>@blockedReason</span>
                        </div>
                    }

                    @if (offers.Count == 0)
                    {
                        <p class="text-secondary mb-0">Aún no ha realizado ofertas sobre esta propiedad.</p>
                    }
                    else
                    {
                        <div>
                            @foreach (var offer in offers)
                            {
                                <div class="offer-row">
                                    <div>
                                        <div class="offer-amount">@offer.Amount.ToString("C0", culture)</div>
                                        <div class="offer-date">@offer.OfferDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <partial name="_OfferStatusBadge" model="offer.Status" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (canOffer)
        {
            <div class="modal fade" id="offerModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" asp-controller="Client" asp-action="SendOffer">
                            <div class="modal-header">
                                <h5 class="modal-title">Enviar nueva oferta</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="PropertyId" value="@Model.Id" />
                                <label class="form-label" for="Amount">Monto ofertado</label>
                                <input class="form-control" id="Amount" name="Amount" type="number" step="0.01" min="0.01" placeholder="Ingrese el monto" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-brand">Enviar oferta</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
