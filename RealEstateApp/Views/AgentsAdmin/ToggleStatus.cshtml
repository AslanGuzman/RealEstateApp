@using RealEstateApp.Core.Application.Dtos.User
@model UserListDto
@{
    ViewData["Title"] = Model.IsActive ? "Inactivar agente" : "Activar agente";
    ViewData["ConfirmIcon"] = "i-user";
    ViewData["ConfirmHeading"] = Model.IsActive
        ? "¿Está seguro que desea inactivar este agente?"
        : "¿Está seguro que desea activar este agente?";
    ViewData["ConfirmSubtitle"] = $"{Model.Name} {Model.LastName} · {Model.Email}";
    ViewData["ConfirmNote"] = Model.IsActive
        ? "El agente no podrá iniciar sesión hasta que se active de nuevo."
        : "El agente podrá iniciar sesión y gestionar sus propiedades.";
    ViewData["ConfirmAction"] = "ToggleStatusConfirmed";
    ViewData["ConfirmController"] = "AgentsAdmin";
    ViewData["ConfirmId"] = Model.Id;
    ViewData["ConfirmExtraName"] = "isActive";
    ViewData["ConfirmExtraValue"] = (!Model.IsActive).ToString().ToLower();
    ViewData["ConfirmButtonText"] = Model.IsActive ? "Inactivar" : "Activar";
    ViewData["ConfirmDanger"] = Model.IsActive;
}

<partial name="_ConfirmPanel" view-data="ViewData" />
