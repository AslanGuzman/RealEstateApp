@using RealEstateApp.Core.Application.Dtos.User
@model List<UserListDto>
@{
    ViewData["Title"] = "Listado de los agentes";
}

<div class="container">
    <div class="page-header">
        <h1>Listado de los agentes</h1>
        <p class="lead-soft">Consulta, activa, inactiva o elimina agentes inmobiliarios</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-user" /></svg>
            <p>@ViewBag.EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="panel p-0">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Correo</th>
                        <th>Propiedades</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@agent.Name @agent.LastName</td>
                            <td>@agent.Email</td>
                            <td>@agent.PropertiesQuantity</td>
                            <td><span class="status-pill @(agent.IsActive ? "status-active" : "status-inactive")">@(agent.IsActive ? "Activo" : "Inactivo")</span></td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-brand" asp-action="ToggleStatus" asp-route-id="@agent.Id">@(agent.IsActive ? "Inactivar" : "Activar")</a>
                                    <a class="btn btn-sm btn-ghost" asp-action="Delete" asp-route-id="@agent.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
