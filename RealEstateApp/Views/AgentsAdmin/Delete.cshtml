@using RealEstateApp.Core.Application.Dtos.User
@model UserListDto
@{
    ViewData["Title"] = "Eliminar agente";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div class="auth-brand"><svg class="icon"><use href="#i-user" /></svg></div>
        <h1>¿Está seguro que desea eliminar este agente y todas sus propiedades?</h1>
        <p class="text-secondary">@Model.Name @Model.LastName · @Model.Email · @Model.PropertiesQuantity propiedades</p>

        <div class="d-flex justify-content-center gap-2 mt-3">
            <form method="post" asp-action="DeleteConfirmed">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-brand">Aceptar</button>
            </form>
            <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
        </div>
    </div>
</div>
