@using RealEstateApp.Core.Application.Dtos.User
@model UserListDto
@{
    ViewData["Title"] = "Eliminar agente";
    ViewData["ConfirmIcon"] = "i-user";
    ViewData["ConfirmHeading"] = "¿Está seguro que desea eliminar este agente y todas sus propiedades?";
    ViewData["ConfirmSubtitle"] = $"{Model.Name} {Model.LastName} · {Model.Email}";
    ViewData["ConfirmNote"] = $"Se eliminarán también sus {Model.PropertiesQuantity} propiedades y todo su historial de ofertas, mensajes y favoritos. Esta acción no se puede deshacer.";
    ViewData["ConfirmAction"] = "DeleteConfirmed";
    ViewData["ConfirmController"] = "AgentsAdmin";
    ViewData["ConfirmId"] = Model.Id;
    ViewData["ConfirmButtonText"] = "Eliminar agente";
    ViewData["ConfirmDanger"] = true;
}

<partial name="_ConfirmPanel" view-data="ViewData" />
