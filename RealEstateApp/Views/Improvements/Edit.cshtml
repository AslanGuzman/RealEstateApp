@model RealEstateApp.Core.Application.ViewModels.Improvement.SaveImprovementViewModel
@{
    ViewData["Title"] = "Editar mejora";
}
<div class="container">
    <div class="page-header"><h1>Editar mejora</h1></div>
    <div class="panel p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-app validation-summary-errors"></div>
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nombre de la mejora</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand">Guardar cambios</button>
                <a class="btn btn-ghost" asp-action="Index">Volver atrás</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
