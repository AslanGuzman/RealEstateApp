@model RealEstateApp.Core.Application.Dtos.Improvement.ImprovementDto
@{
    ViewData["Title"] = "Eliminar mejora";
    ViewData["ConfirmIcon"] = "i-check";
    ViewData["ConfirmHeading"] = "¿Está seguro que desea eliminar esta mejora?";
    ViewData["ConfirmSubtitle"] = Model.Name;
    ViewData["ConfirmNote"] = "Solo se eliminará la mejora de las propiedades que la tengan asociada. Las propiedades no se eliminarán.";
    ViewData["ConfirmAction"] = "DeleteConfirmed";
    ViewData["ConfirmController"] = "Improvements";
    ViewData["ConfirmId"] = Model.Id;
    ViewData["ConfirmButtonText"] = "Eliminar";
    ViewData["ConfirmDanger"] = true;
}

<partial name="_ConfirmPanel" view-data="ViewData" />
