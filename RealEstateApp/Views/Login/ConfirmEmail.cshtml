@{
    ViewData["Title"] = "Activación de cuenta";
    var confirmed = ViewBag.Confirmed as bool? ?? false;
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div class="auth-brand">
            <svg class="icon"><use href="#i-building" /></svg>
        </div>
        <h1>@(confirmed ? "Cuenta activada" : "Activación fallida")</h1>
        <p class="text-secondary">@ViewBag.Message</p>
        @if (confirmed)
        {
            <a class="btn btn-brand mt-2" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
        }
        else
        {
            <a class="btn btn-outline-brand mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        }
    </div>
</div>
