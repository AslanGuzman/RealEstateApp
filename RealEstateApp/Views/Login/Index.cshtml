@model LoginViewModel?
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center auth-brand">
            <svg class="icon"><use href="#i-building" /></svg>
        </div>
        <h1 class="text-center mb-1">Bienvenido de nuevo</h1>
        <p class="text-center text-secondary mb-4">Ingresa tus credenciales para continuar</p>

        @if (TempData["RegisterMessage"] != null)
        {
            <div class="alert alert-success alert-app">@TempData["RegisterMessage"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-app validation-summary-errors"></div>

        <form method="post" asp-controller="Login" asp-action="Index">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">Correo o nombre de usuario</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserName" class="field-validation-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100 py-2">Iniciar sesión</button>
        </form>

        <p class="text-center text-secondary mt-4 mb-0">
            ¿No tienes cuenta? <a class="text-decoration-none" asp-controller="Join" asp-action="Index">Únete a la app</a>
        </p>
        <p class="text-center mt-2 mb-0">
            <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
