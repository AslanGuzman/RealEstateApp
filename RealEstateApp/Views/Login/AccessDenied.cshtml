@{
    ViewData["Title"] = "Acceso denegado";
    var roleHomeController = "Home";

    if (User.IsInRole("Admin"))
    {
        roleHomeController = "Admin";
    }
    else if (User.IsInRole("Agent"))
    {
        roleHomeController = "AgentHome";
    }
    else if (User.IsInRole("Client"))
    {
        roleHomeController = "Client";
    }
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <div class="auth-brand">
            <svg class="icon"><use href="#i-building" /></svg>
        </div>
        <h1>Acceso denegado</h1>
        <p class="text-secondary">No tienes permisos para acceder a esta sección de la aplicación.</p>
        <a class="btn btn-brand mt-2" asp-controller="@roleHomeController" asp-action="Index">Ir a mi página de inicio</a>
    </div>
</div>
