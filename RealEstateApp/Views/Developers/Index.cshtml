@using RealEstateApp.Core.Application.Dtos.User
@model List<UserListDto>
@{
    ViewData["Title"] = "Mantenimiento de desarrolladores";
}

<div class="container">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1>Mantenimiento de desarrolladores</h1>
            <p class="lead-soft">Gestiona los usuarios con rol Desarrollador para el acceso al API</p>
        </div>
        <a class="btn btn-brand" asp-action="Create">Crear desarrollador</a>
    </div>

    <div class="panel p-0">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Nombre</th>
                    <th>Usuario</th>
                    <th>Cédula</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var developer in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@developer.Name @developer.LastName</td>
                        <td>@developer.UserName</td>
                        <td>@developer.IdentityCard</td>
                        <td>@developer.Email</td>
                        <td><span class="status-pill @(developer.IsActive ? "status-active" : "status-inactive")">@(developer.IsActive ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <a class="btn btn-sm btn-outline-brand" asp-action="Edit" asp-route-id="@developer.Id">Editar</a>
                                <a class="btn btn-sm btn-ghost" asp-action="ToggleStatus" asp-route-id="@developer.Id">@(developer.IsActive ? "Inactivar" : "Activar")</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
