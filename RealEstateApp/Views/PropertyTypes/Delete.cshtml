    ViewData["ConfirmController"] = "PropertyTypes";
    ViewData["ConfirmId"] = Model.Id;
    ViewData["ConfirmButtonText"] = "Eliminar";
    ViewData["ConfirmDanger"] = true;
}

<partial name="_ConfirmPanel" view-data="ViewData" />
