@model RealEstateApp.Core.Application.Dtos.PropertyType.PropertyTypeDto
@{
    ViewData["Title"] = "Eliminar tipo de propiedad";
    ViewData["ConfirmIcon"] = "i-building";
    ViewData["ConfirmHeading"] = "¿Está seguro que desea eliminar este tipo de propiedad?";
    ViewData["ConfirmSubtitle"] = Model.Name;
    ViewData["ConfirmNote"] = "Se eliminarán también las propiedades asociadas con sus imágenes, mejoras, ofertas, mensajes y favoritos. Esta acción no se puede deshacer.";
