@model SavePropertyViewModel
@{
    var propertyTypes = ViewBag.PropertyTypes as List<RealEstateApp.Core.Application.Dtos.PropertyType.PropertyTypeDto> ?? [];
    var saleTypes = ViewBag.SaleTypes as List<RealEstateApp.Core.Application.Dtos.SaleType.SaleTypeDto> ?? [];
    var improvements = ViewBag.Improvements as List<RealEstateApp.Core.Application.Dtos.Improvement.ImprovementDto> ?? [];
    var isEdit = Model.Id != 0;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger alert-app validation-summary-errors"></div>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="PropertyTypeId" class="form-label">Tipo de propiedad</label>
            <select asp-for="PropertyTypeId" class="form-select">
                <option value="">Seleccione una opción</option>
                @foreach (var type in propertyTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
            <span asp-validation-for="PropertyTypeId" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SaleTypeId" class="form-label">Tipo de venta</label>
            <select asp-for="SaleTypeId" class="form-select">
                <option value="">Seleccione una opción</option>
                @foreach (var sale in saleTypes)
                {
                    <option value="@sale.Id">@sale.Name</option>
                }
            </select>
            <span asp-validation-for="SaleTypeId" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Price" class="form-label">Precio (DOP)</label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Price" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LandSize" class="form-label">Tamaño (m²)</label>
            <input asp-for="LandSize" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="LandSize" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Rooms" class="form-label">Habitaciones</label>
            <input asp-for="Rooms" type="number" min="0" class="form-control" />
            <span asp-validation-for="Rooms" class="field-validation-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Bathrooms" class="form-label">Baños</label>
            <input asp-for="Bathrooms" type="number" min="0" class="form-control" />
            <span asp-validation-for="Bathrooms" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Mejoras</label>
            <div class="row row-cols-2 row-cols-md-3 g-2">
                @foreach (var improvement in improvements)
                {
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="ImprovementIds" value="@improvement.Id" id="imp-@improvement.Id"
                                   checked="@(Model.ImprovementIds.Contains(improvement.Id))" />
                            <label class="form-check-label" for="imp-@improvement.Id">@improvement.Name</label>
                        </div>
                    </div>
                }
            </div>
            <span asp-validation-for="ImprovementIds" class="field-validation-error"></span>
        </div>

        @if (isEdit && Model.CurrentImages.Count > 0)
        {
            <div class="col-12">
                <label class="form-label">Imágenes actuales</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var image in Model.CurrentImages)
                    {
                        <img src="~/@image" alt="Imagen actual" class="maint-thumb maint-thumb-lg" />
                    }
                </div>
            </div>
        }

        <div class="col-12">
            <label asp-for="Images" class="form-label">
                Imágenes de la propiedad @(isEdit ? "(opcional, reemplaza las actuales)" : "(de 1 a 4)")
            </label>
            <input asp-for="Images" type="file" class="form-control" accept=".jpg,.jpeg,.png" multiple />
            <span asp-validation-for="Images" class="field-validation-error"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-brand">@(isEdit ? "Guardar propiedad" : "Crear propiedad")</button>
        <a class="btn btn-ghost" asp-controller="PropertyMaintenance" asp-action="Index">Volver atrás</a>
    </div>
</form>
