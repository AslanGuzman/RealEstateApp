@model PropertyDto
@{
    ViewData["Title"] = "Eliminar propiedad";
    var culture = new CultureInfo("es-DO");
    ViewData["ConfirmIcon"] = "i-building";
    ViewData["ConfirmHeading"] = "¿Está seguro que desea eliminar esta propiedad?";
    ViewData["ConfirmSubtitle"] = $"Código {Model.Code} · {Model.PropertyTypeName} · {Model.Price.ToString("C0", culture)}";
    ViewData["ConfirmNote"] = "Se eliminarán también sus imágenes, mejoras, ofertas, mensajes y favoritos. Esta acción no se puede deshacer.";
    ViewData["ConfirmAction"] = "DeleteConfirmed";
    ViewData["ConfirmController"] = "PropertyMaintenance";
    ViewData["ConfirmId"] = Model.Id;
    ViewData["ConfirmButtonText"] = "Eliminar propiedad";
    ViewData["ConfirmDanger"] = true;
}

<partial name="_ConfirmPanel" view-data="ViewData" />
