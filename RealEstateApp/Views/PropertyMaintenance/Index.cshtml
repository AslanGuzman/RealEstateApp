@model List<PropertyDto>
@{
    ViewData["Title"] = "Mantenimiento de propiedades";
    var culture = new CultureInfo("es-DO");
}

<div class="container">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <h1>Mantenimiento de propiedades</h1>
            <p class="lead-soft">Administra tus propiedades disponibles</p>
        </div>
        <a class="btn btn-brand" asp-controller="PropertyMaintenance" asp-action="Create">Crear propiedad</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-building" /></svg>
            <p>@ViewBag.EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="panel p-0">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Imagen</th>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Venta</th>
                        <th>Precio</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (property.Images.Count > 0)
                                {
                                    <img src="~/@property.Images.First()" alt="Propiedad @property.Code" class="maint-thumb" />
                                }
                                else
                                {
                                    <span class="maint-thumb maint-thumb-empty"><svg class="icon"><use href="#i-building" /></svg></span>
                                }
                            </td>
                            <td class="fw-semibold">@property.Code</td>
                            <td>@property.PropertyTypeName</td>
                            <td>@property.SaleTypeName</td>
                            <td>@property.Price.ToString("C0", culture)</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-brand" asp-controller="PropertyMaintenance" asp-action="Edit" asp-route-id="@property.Id">Editar</a>
                                    <a class="btn btn-sm btn-ghost" asp-controller="PropertyMaintenance" asp-action="Delete" asp-route-id="@property.Id">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
