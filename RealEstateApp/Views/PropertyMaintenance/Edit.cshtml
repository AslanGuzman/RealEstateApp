@model SavePropertyViewModel
@{
    ViewData["Title"] = "Editar propiedad";
}

<div class="container">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
        <div>
            <h1>Editar propiedad</h1>
            <p class="lead-soft">Código @Model.Code · el código no puede modificarse</p>
        </div>
    </div>

    <div class="panel p-4">
        <partial name="_PropertyForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
