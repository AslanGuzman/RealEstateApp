@model PropertyDto?
@{
    ViewData["Title"] = Model == null ? "Propiedad no disponible" : $"Propiedad {Model.Code}";
    var culture = new CultureInfo("es-DO");
    var agent = ViewBag.AgentContact as AgentContactDto;
}

<div class="container py-4">
    @if (Model == null)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-building" /></svg>
            <p>@ViewBag.EmptyMessage</p>
            <a class="btn btn-outline-brand mt-3" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb" class="pt-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-decoration-none" asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li class="breadcrumb-item active" aria-current="page">Propiedad @Model.Code</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-8">
                <partial name="_PropertyGallery" model="Model" />

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                    <div>
                        <span class="badge-type">@Model.PropertyTypeName</span>
                        <span class="badge-type">@Model.SaleTypeName</span>
                    </div>
                    <span class="code text-secondary">Código @Model.Code</span>
                </div>

                <h1 class="mt-2 money">@Model.Price.ToString("C0", culture)</h1>

                <div class="detail-facts mt-3">
                    <div class="fact">
                        <span class="fact-label">Habitaciones</span>
                        <span class="fact-value"><svg class="icon"><use href="#i-bed" /></svg> @Model.Rooms</span>
                    </div>
                    <div class="fact">
                        <span class="fact-label">Baños</span>
                        <span class="fact-value"><svg class="icon"><use href="#i-bath" /></svg> @Model.Bathrooms</span>
                    </div>
                    <div class="fact">
                        <span class="fact-label">Tamaño</span>
                        <span class="fact-value"><svg class="icon"><use href="#i-ruler" /></svg> @Model.LandSize.ToString("N0", culture) m²</span>
                    </div>
                </div>

                <h2 class="section-title mt-4">Descripción</h2>
                <p class="text-secondary">@Model.Description</p>

                <h2 class="section-title mt-4">Mejoras</h2>
                @if (Model.Improvements.Count == 0)
                {
                    <p class="text-secondary">Esta propiedad no tiene mejoras registradas.</p>
                }
                else
                {
                    <div>
                        @foreach (var improvement in Model.Improvements)
                        {
                            <span class="improvement-chip">
                                <svg class="icon"><use href="#i-check" /></svg>
                                @improvement.Name
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="panel agent-panel p-4 text-center">
                    <h2 class="section-title">Agente inmobiliario</h2>
                    @if (agent == null)
                    {
                        <p class="text-secondary mb-0">La información del agente no está disponible.</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(agent.ProfileImage))
                        {
                            <img class="avatar mb-3" src="~/@agent.ProfileImage" alt="Foto de @agent.Name" />
                        }
                        else
                        {
                            <span class="avatar-empty mb-3">
                                <svg class="icon"><use href="#i-user" /></svg>
                            </span>
                        }
                        <h3 class="h5 mb-3">@agent.Name @agent.LastName</h3>
                        <p class="mb-2 text-secondary">
                            <svg class="icon"><use href="#i-phone" /></svg>
                            @(string.IsNullOrWhiteSpace(agent.Phone) ? "Sin teléfono registrado" : agent.Phone)
                        </p>
                        <p class="mb-0 text-secondary">
                            <svg class="icon"><use href="#i-mail" /></svg>
                            @agent.Email
                        </p>
                    }
                </div>
            </div>
        </div>
    }
</div>
