@model List<PropertyDto>
@{
    ViewData["Title"] = "Inicio";
    ViewData["SearchController"] = "Home";
    ViewData["SearchHint"] = "La búsqueda por código muestra una sola propiedad e ignora los filtros.";
}

<section class="search-hero">
    <div class="container">
        <h1>Encuentra tu próxima propiedad</h1>
        <p class="lead-soft">Explora las propiedades disponibles en toda República Dominicana</p>
        <partial name="_SearchBar" view-data="ViewData" />
    </div>
</section>

<div class="container py-4">
    <div class="home-layout">
        <partial name="_PropertyFilters" model="null" view-data="ViewData" />

        <div>
            <partial name="_ActiveFilterChips" view-data="ViewData" />

            @if (Model.Count > 0)
            {
                <p class="results-count">@Model.Count @(Model.Count == 1 ? "propiedad disponible" : "propiedades disponibles")</p>
            }

            <partial name="_PropertyGrid" model="Model" view-data="ViewData" />
        </div>
    </div>
</div>
